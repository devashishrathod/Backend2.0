# ---------------------------------------------------------------------------
# Which tier this is — and the one thing the guards read
#
# DEVELOPMENT | STAGING | PRODUCTION.  Upper case, like every enum this project
# owns.
#
# ⚠️ Deliberately not NODE_ENV. That comes from the shell, and on at least one
# machine here it is `production` on a laptop pointed at a development database
# with Razorpay test keys — so a guard keyed on it would fire where it must not
# and stay silent where it must. CONFIG_PROFILE lives in this file, so the file
# says what it is.
#
# PRODUCTION makes `configs/env` refuse to start unless MONGO_URL names a
# database with "prod" in it and the Razorpay keys are `rzp_live_`.
#
# ⚠️ NODE_ENV stays lower case. It is npm's and Express's, not ours: npm reads
# `production` to skip devDependencies, and Express compares against
# "production" to decide whether to hide error stack traces from clients.
# NODE_ENV=PRODUCTION matches neither.
# ---------------------------------------------------------------------------
CONFIG_PROFILE=DEVELOPMENT

# Trydood 2.0 — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way; this
# file carries names and shapes only, never a value.
#
# Anything marked REQUIRED has no working default — the server boots without it
# but the feature behind it fails at the first request. Everything else degrades
# gracefully, and `logChannelStatus()` / `logPaymentAccounts()` print exactly
# what is and is not configured on every boot. Read that block after a deploy.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=8000
# REQUIRED. Include the database name in the path — the money tests derive
# `<name>_test` from it, and a string with no name at all falls back to a guess.
MONGO_URL=
# `production` in production. ⚠️ Setting this locally makes npm skip
# devDependencies (`omit=dev`), so `npm install` silently leaves jest out.
NODE_ENV=development
# REQUIRED. Rotating it invalidates every issued token.
JWT_SECRET=
JWT_EXPIRY=30d
# Seed/dev convenience only. Never set in production.
DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# Panels and public links
# ---------------------------------------------------------------------------
# Deep-link bases for notification buttons. Unset means the button is omitted
# rather than rendered broken.
ADMIN_PANEL_URL=
VENDOR_PANEL_URL=
# Base for customer-facing links that come from the API itself — the invoice
# download URL and the WhatsApp template button. Unset is a clean degradation:
# `publicUrl()` returns undefined and the button is left out. Boot says so.
PUBLIC_API_URL=
# The customer app's universal / app link host, e.g. https://app.trydood.com
#
# A customer's destination is an app SCREEN, so an email button needs a host that
# both platforms resolve into the app. That host must serve:
#   Android  /.well-known/assetlinks.json
#   iOS      /.well-known/apple-app-site-association
#
# ⚠️ It must ALSO serve a page for the case where the app is not installed — the
# tap lands in a browser there, and sending the reader to the Play Store or the
# App Store can only be done at that host by sniffing the user agent. The backend
# only emits the address; there is no way to express "…or the store" in a link.
#
# ⚠️ That page must NEVER collect bank details. REFUND_BANK_DETAILS_REQUESTED
# links here, and its copy promises we never ask for details over a message.
#
# Unset means all ten customer emails lose their button. Boot says so.
CUSTOMER_APP_URL=

# ---------------------------------------------------------------------------
# Razorpay — TWO separate accounts
#
# VENDOR   = vendor subscription checkout
# CUSTOMER = customer voucher claims
#
# Separate merchants with separate dashboards, so separate keys AND separate
# webhook secrets. Never reuse one account's credentials for the other: the
# account is chosen from `transaction.gatewayAccount`, and a mismatch means a
# lookup against the wrong merchant that returns "payment not found".
# ---------------------------------------------------------------------------
RAZORPAY_VENDOR_KEY_ID=
RAZORPAY_VENDOR_SECRET=
RAZORPAY_CUSTOMER_KEY_ID=
RAZORPAY_CUSTOMER_SECRET=
# Account-agnostic API base.
RAZORPAY_BASEURL=https://api.razorpay.com

# Webhook signing secrets, **comma-separated**. A list rather than one value so
# a secret can be rotated without downtime: add the new one, update the
# dashboard, then drop the old one on the next deploy. Every secret in the list
# is tried.
RAZORPAY_WEBHOOK_SECRETS=
RAZORPAY_CUSTOMER_WEBHOOK_SECRETS=
# Legacy single-value name, read last for the VENDOR account. Kept so an
# existing deployment does not break the moment it upgrades; new setups should
# use the plural above.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Set to the string "false" to disable every sweep on this instance. ⚠️ Left set
# by accident this is the quietest failure in the system — nothing errors, the
# safety nets simply stop. Boot prints a line when it is off, and the JobLock
# health record makes a stalled runner visible after the fact.
# ENABLE_JOBS=false

# ---------------------------------------------------------------------------
# Cloudinary — media
# ---------------------------------------------------------------------------
CLOUDINARY_URL=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_SECRET=
CLOUD_BASE_URL=

# ---------------------------------------------------------------------------
# AWS S3 — media.  Full setup: docs/aws_s3_setup.md
# ---------------------------------------------------------------------------
# Which provider NEW uploads go to. Deleting an existing asset always follows
# that row's own storage.provider, so flipping this never strands old files.
MEDIA_PROVIDER=CLOUDINARY

AWS_REGION=ap-south-1

# Split by who may SEE the file, not by who uploads it: a showcase video is
# uploaded by a vendor and watched by guests, and an invoice is read by both a
# vendor and a customer. Uploader role tells you nothing about visibility.
S3_BUCKET_PUBLIC=trydood-nonprod-public
S3_BUCKET_PRIVATE=trydood-nonprod-private

# Key prefix for this tier — dev/ or staging/, and EMPTY in production. It is
# what lets dev and staging share one bucket without sharing objects.
S3_PREFIX=dev/

# CloudFront in front of the public bucket. Without it, URLs fall back to the
# bucket's own S3 endpoint.
CDN_BASE_URL=

# The AWS SDK reads these itself — nothing in this repo does, and they are not
# in configs/env/schema.js for that reason.
#
#   Render  : set them (an IAM user with access to the non-prod buckets only)
#   EC2     : leave them EMPTY and attach an instance role instead
#
# They must be BLANK on a host with a role. Environment keys beat the role in
# the SDK's lookup order, so a leftover key keeps working until it is revoked,
# and then every upload fails with nothing in any log to say why.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Replaced by the public/private split above. Nothing reads these three.
# 🔴 Do NOT set them in production — the boot guard requires every bucket name
#    to contain "prod", and these do not, so the server refuses to start.
S3_BUCKET_VENDOR=trydood-vendor
S3_BUCKET_ADMIN=trydood-admin
S3_BUCKET_CUSTOMER=trydood-customer

# ---------------------------------------------------------------------------
# Email (Nodemailer)
# ---------------------------------------------------------------------------
NODEMAILER_EMAIL=
# A Gmail app password, not the account password.
NODEMAILER_PASSWORD=
NODEMAILER_APP_NAME=Trydood

# ---------------------------------------------------------------------------
# Push (Firebase Cloud Messaging)
#
# All three or none — a partial set is treated as unconfigured.
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The full PEM including the BEGIN/END lines, with newlines written as \n.
FCM_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# WhatsApp templates
#
# Two gates, both required: the channel flag in
# `Setting.vendor.subscription.isWhatsAppNotificationEnabled` AND an approved
# template id for that specific message type. Either one missing is a clean
# skip, not an error — which is what lets templates go live one at a time as
# Meta approves them.
# ---------------------------------------------------------------------------
WHATSAPP_TEMPLATE_BRAND_UNDER_REVIEW=
WHATSAPP_TEMPLATE_BRAND_APPROVED=
WHATSAPP_TEMPLATE_BRAND_REJECTED=
WHATSAPP_TEMPLATE_BRAND_RESUBMITTED=
WHATSAPP_TEMPLATE_BRAND_APPROVAL_REVOKED=
WHATSAPP_TEMPLATE_BRAND_ACTIVATED=
WHATSAPP_TEMPLATE_BRAND_DEACTIVATED=
WHATSAPP_TEMPLATE_BRAND_VISIBLE_TO_CUSTOMERS=
WHATSAPP_TEMPLATE_BRAND_HIDDEN_FROM_CUSTOMERS=
WHATSAPP_TEMPLATE_SUBSCRIPTION_ACTIVATED=
WHATSAPP_TEMPLATE_SUBSCRIPTION_RENEWED=
WHATSAPP_TEMPLATE_SUBSCRIPTION_UPGRADED=
WHATSAPP_TEMPLATE_SUBSCRIPTION_DOWNGRADED=
WHATSAPP_TEMPLATE_SUBSCRIPTION_CANCELLED=
WHATSAPP_TEMPLATE_SUBSCRIPTION_EXPIRING=
WHATSAPP_TEMPLATE_SUBSCRIPTION_EXPIRED=
WHATSAPP_TEMPLATE_SUBSCRIPTION_GRANTED=

# ---------------------------------------------------------------------------
# OTP / SMS
# ---------------------------------------------------------------------------
TWO_FACTOR_API_KEY=
TENDIGIT_BASEURL=
TENDIGIT_APIKEY=
TENDIGIT_LICENSE=
TENDIGIT_TEMPLATE_ID=
# Signs the OTP hash. Rotating it invalidates every OTP in flight.
OTP_HMAC_SECRET=

# ---------------------------------------------------------------------------
# CGPEY — PAN / GST / bank verification
# ---------------------------------------------------------------------------
CGPEY_BASE_URL=
CGPEY_MERCHANT_ID=
CGPEY_API_KEY=
CGPEY_SECRET_KEY=
CGPEY_PAN_ENDPOINT=
CGPEY_GST_ENDPOINT=
CGPEY_BANK_ENDPOINT=
CGPEY_TIMEOUT=15000

# ---------------------------------------------------------------------------
# Identifier salts
#
# Used to derive public-facing merchant and store ids. Changing one changes
# every id derived from it, so treat these as permanent once live.
# ---------------------------------------------------------------------------
MERCHANT_ID_SECRET=
STORE_ID_SECRET=

# ---------------------------------------------------------------------------
# ngrok — local webhook testing only
#
# Razorpay needs a public URL to deliver to. Never enable in production.
# ---------------------------------------------------------------------------
ENABLE_NGROK=false
NGROK_AUTH_TOKEN=
NGROK_SUBDOMAIN=

# ---------------------------------------------------------------------------
# Uploads
#
# A ceiling on any single uploaded file, in megabytes. This protects the
# process — it is not the limit a vendor meets. The per-surface limits (10 MB
# for a showcase image, 50 MB for a showcase video) live in `Setting` and are
# enforced with a message naming the surface.
#
# Read once at start-up, so a change needs a restart.
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100

# ---------------------------------------------------------------------------
# Runtime / ops toggles
#
# All optional — the code carries a default for each. They are listed here
# because a reader has no other way to learn they exist, and two of them change
# behaviour that is expensive to get wrong.
# ---------------------------------------------------------------------------

# How many proxies sit in front of this process.
#
# ⚠️ Trusting a hop that is not there means believing an `X-Forwarded-For`
# header the caller wrote themselves, which is a free pass around the rate
# limiter. Render and an ALB are one hop each. Set 0 on a bare EC2 box.
TRUST_PROXY=1

# Requests per IP per 15 minutes. Deliberately high: Indian mobile networks put
# thousands of real customers behind one carrier-grade NAT address, so a tight
# limit locks out a city block rather than stopping anybody.
RATE_LIMIT_MAX=3000

# morgan format. Defaults to `combined` when NODE_ENV is production, else `dev`.
LOG_FORMAT=

# ⚠️ Set `false` on a development machine. There are 21 background jobs, and on
# a laptop they run against the shared development database and send real
# notifications.
ENABLE_JOBS=true

# ---------------------------------------------------------------------------
# Database tuning
#
# ⚠️ `MONGO_AUTO_INDEX=false` is right for production — Mongoose otherwise
# re-checks every schema against the server on first use of each model, which is
# roughly a minute of round trips in the window after a deploy when there is
# most traffic. It is only safe with `node scripts/ensureIndexes.js --apply` in
# the deploy, because the money paths depend on partial unique indexes for
# correctness, and a missing one fails silently: the second row is accepted.
# ---------------------------------------------------------------------------
MONGO_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=
MONGO_SERVER_SELECTION_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Test-only — never set these on a server
# ---------------------------------------------------------------------------

# Holds the money suite's connection open past teardown, for debugging something
# that needs the socket to survive.
TEST_DB_KEEP_CONNECTION=

# Pins the timezone for the mail-render test's date assertions.
TZ=
